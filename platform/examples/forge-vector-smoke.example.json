{
  "schema": "ace-echo-forge-request/v1",
  "intent": "Exercise the self-contained two-task vector development loop; software onboarding only",
  "source": {
    "kind": "venus_source",
    "language": "Venus C/BAS",
    "root": "../workloads/5g_lite/tasks/forge_vector_smoke"
  },
  "backend_manifest": "../.ace-echo/host/backend.json",
  "reference": {"state": "PROVISIONAL_GOLDEN"},
  "workload": {
    "kind": "dag",
    "name": "forge-vector-smoke",
    "required_correctness_scopes": ["gem5_task_output_exact", "gem5_final_dag_output_exact"]
  },
  "optimization": {
    "primary_metric": "gem5_ticks", "max_candidates": 3, "plateau_candidates": 2,
    "ai_first": true, "one_hypothesis_per_candidate": true
  },
  "cleanup": {"after_application_complete": true, "retain_top_correct": 3},
  "validation": {
    "vemu_forbidden": true, "rtl_source_immutable": true,
    "compare_all_visible_outputs": true, "freeze_case_inputs_and_outputs": true
  }
}
