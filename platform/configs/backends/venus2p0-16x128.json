{
  "schema": "ace-echo-backend-manifest/v1",
  "backend_id": "venus2p0-16x128",
  "display_name": "Venus 2.0, 16 lanes x 128 rows",
  "architecture": {
    "generation": "2.0",
    "rows": 128,
    "lanes": 16,
    "banks_per_lane": 4,
    "bank_width_bits": 16,
    "workspace_alignment_bytes": 64,
    "workspace_limit_bytes": 409600,
    "supported_element_width_bits": [8, 16]
  },
  "abi": {
    "compiled_return_registers": {
      "format": "venus-mmio-return-ir-v1",
      "count_address": "0x801ff02c",
      "length_base": "0x801ff034",
      "stride_bytes": 8,
      "port_count": 16
    },
    "task_input_descriptor": {
      "physical_type_bits": 3,
      "logical_to_physical_type": {
        "0": 0,
        "1": 1,
        "2": 2,
        "4": 4,
        "5": 5,
        "6": 5
      },
      "rtl_unsupported_logical_types": [],
      "rtl_evidence": "bf82d804: 3-bit descriptors; task_manager.sv FSM_TASK_FIRING_1 fetches the global parameter for physical 5 but not 6. Runtime pointer logical 6 uses physical 5 while retaining L1 dynamic-input ownership. See docs/VENUS2_POINTER_ABI.md."
    },
    "task_call": {
      "register_argument_count": 8,
      "stack_arguments_supported": false
    },
    "task_container": {
      "includes_spmd_fields": true,
      "rtl_evidence": "hardware/L2_scheduler/l2_scheduler_pkg.sv:53-68"
    },
    "scheduler_output": {
      "max_task_outputs": 16,
      "max_dag_outputs": 8,
      "max_dag_outputs_rtl_evidence": "hardware/L2_scheduler/l2_scheduler_pkg.sv:40",
      "task_return_length_bits": 32,
      "vreturn_length_unit": "bytes",
      "variable_length_outputs": true,
      "dma_beat_bytes": 64,
      "descriptor_response_lag_ports": 0,
      "descriptor_transfer_chunk_bytes": 64,
      "completion_poll_fallback": true,
      "completion_poll_interval": 4096
    }
  },
  "paths": {
    "dsl_root": "../../components/toolchain/dsl",
    "workload_root": "../../workloads/5g_lite",
    "gem5_root": "../../components/gem5",
    "scheduler_root": "../../components/scheduler",
    "rtl_root": "/home/shenyihao/Project/Venus_3/venus_soc"
  },
  "repositories": {
    "dsl": {
      "submodule_path": "components/toolchain/dsl",
      "required_branch": "ace-echo"
    },
    "applications": {
      "submodule_path": "workloads",
      "required_branch": "main"
    }
  },
  "execution_policy": {
    "forbidden_engines": ["vemu"],
    "fast_search_engine": "gem5.fast",
    "full_software_engine": "gem5.fast",
    "diagnostic_engine": "gem5.verification",
    "hardware_engine": "rtl",
    "rtl_only_after_full_software_pass": true,
    "rtl_only_for_integrated_winner": true
  },
  "engines": {
    "scheduler": {
      "build_target": "venus"
    },
    "gem5": {
      "fast": {
        "binary": "build/RISCV/gem5.opt",
        "config": "configs/tutorial/part1/packet_gen.py",
        "venus_config": "venus-rtl-16x128",
        "claim_scope": "fast_functional_search"
      },
      "verification": {
        "binary": "build/RISCV/gem5.debug",
        "config": "configs/tutorial/part1/packet_gen.py",
        "venus_config": "venus-rtl-16x128",
        "claim_scope": "full_gem5_verification"
      }
    },
    "rtl": {
      "source_immutable": true,
      "fresh_build_required": true,
      "required_repository_identity": true,
      "generated_output_allowlist": [
        "sim/build_*/**",
        "sim/testbenches/postsyn_tilelevel_descriptor/*/generated/**"
      ],
      "preflight": {
        "required_tools": ["vlogan", "vcs"],
        "license_environment": [
          "LM_LICENSE_FILE",
          "SNPSLMD_LICENSE_FILE"
        ],
        "license_connect_timeout_seconds": 1.0,
        "systemverilog_function_arity": [
          {
            "id": "overall-testbench-vins-enqueue-api",
            "function": "vins_enqueue",
            "declaration_file": "sim/model/venus_extension/internal_model.sv",
            "call_files": [
              "sim/testbenches/testbench_gc0802_boot.sv"
            ]
          }
        ]
      },
      "flow": {
        "snapshot_excludes": [
          ".git",
          "sim/build_*"
        ],
        "firmware_destinations": [
          "software/scheduler/l1.bin",
          "software/gatesim/gc0802_overall/{case_name}/l1.bin"
        ],
        "fresh_build_target": "sim_compileall",
        "fresh_build_steps": [
          "analyze_dut_nodebug",
          "analyze_tb_nodebug",
          "elaborate_nodebug"
        ],
        "fresh_simulator_path": "sim/build_{SIM_NAME}{SIM_TYPE}/simv",
        "timeouts": {
          "build_seconds": 1800,
          "simulation_seconds": 1800
        },
        "return_identity": {
          "protocol": "venus-serial-ack-v1",
          "tile_address_base": "0x82000000",
          "tile_address_stride": "0x200000",
          "tile_count": 4
        },
        "startup_diagnostics": [
          {
            "id": "v2-devctrl-decode-time-zero-toggle",
            "source_file": "hardware/soc_hierachy/venus_gc0802_ccm_devctrl/venus_gc0802_devctrl.sv",
            "source_sha256": "645c5c2c5efc6f908add902b5b556164c075e09ab2943054bdc9b8ac7e9b0911",
            "instance": "testbench.tb.pad.dut.u_venus_gc0802_devctrl",
            "message": "regen_mbist_enable_done2 toggle unexpectedly",
            "max_occurrences": 1
          }
        ],
        "replay_target": "sim_nocompile",
        "make_variables": {
          "SIM_NAME": "gc0802_",
          "TESTBENCH_NAME": "overall",
          "SIM_TYPE": "simonly"
        },
        "runtime_case_variable": "TARGET_BIN_FILE_NAME",
        "unique_build_variable": "COPY_ID",
        "path_prepend": [
          "/server17/ic/synopsys/vcs-mx/O-2018.09-SP2-11/bin"
        ],
        "required_environment": {
          "VCS_HOME": "/server17/ic/synopsys/vcs-mx/O-2018.09-SP2-11",
          "DESIGNWARE_HOME": "/server17/ic/synopsys/package",
          "SLI_USER_SLISERV_PATH": "/server17/ic/synopsys/package/vip/common/latest/C/lib/amd64/sliserv",
          "LM_LICENSE_FILE": "27000@localhost",
          "SNPSLMD_LICENSE_FILE": "27000@localhost"
        },
        "progress_markers": {
          "boot": "GPIO0",
          "main_entry": "GPIO1",
          "dag_complete": "GPIO2",
          "crc_complete": "GPIO3",
          "crc_failure": "GPIO4"
        },
        "evidence_paths": [
          "sim.log",
          "L2_DMA_trx.log",
          "dma_read_data_file_L1.txt",
          "dma_read_data_file_L2.txt",
          "L2_scheduler_task_allocation_info.txt",
          "vins_result/**"
        ]
      },
      "claim_scope": "rtl_bit_exact"
    }
  },
  "correctness_scopes": [
    "reference_case_exact",
    "gem5_task_output_exact",
    "gem5_dag_task_boundary_exact",
    "gem5_final_dag_output_exact",
    "rtl_all_visible_outputs_exact"
  ],
  "performance": {
    "primary_metric": "gem5_ticks",
    "direction": "minimize",
    "fast_profile_rankable": true,
    "verification_profile_required_for_winner": false,
    "wall_clock_rankable": false
  },
  "static_gates": {
    "require_contiguous_memory_operations": true,
    "require_equal_declared_vector_types": true,
    "require_i16_shuffle_indices": true,
    "initialized_task_global_data_requires_address_audit": true,
    "check_physical_row_encoding": true,
    "check_lsu_boundary_crossing": true,
    "check_task_call_register_abi": true,
    "check_task_output_count_and_lengths": true
  },
  "knowledge": {
    "foundation": "docs/knowledge/foundations/venus-user-guide.md",
    "seed_prompts": "docs/knowledge/seed-prompts.json",
    "live_registry": "docs/knowledge/live/registry.json"
  }
}
