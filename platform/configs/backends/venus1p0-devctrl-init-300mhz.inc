  /*
   * Venus1.0 GC0802 PLL, divider and reset sequence for the 300 MHz
   * performance profile.
   *
   * This sequence is reconstructed from the repository-qualified
   * simpledagfire firmware at commit a34a99a.  Later Scheduler defaults use
   * Venus2.0 PLL encodings and wait forever for the V1 lock response.  The
   * final DEBUG write differs intentionally: bit 8 selects the already
   * configured 300 MHz BPLL for cluster 0 after its soft reset is released.
   */
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_MPLL_REG_OFFSET, 0x03020218);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_MPLL_REG_OFFSET, 0x00020218);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_MPLL_REG_OFFSET, 0x00030118);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_MPLL_REG_OFFSET, 0x0002010c);

  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_DFEPLL_REG_OFFSET, 0x03030440);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_DFEPLL_REG_OFFSET, 0x00030440);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_DFEPLL_REG_OFFSET, 0x00020220);

  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_BPLL_REG_OFFSET, 0x03020218);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_BPLL_REG_OFFSET, 0x00020218);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_BPLL_REG_OFFSET, 0x00030118);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_BPLL_REG_OFFSET, 0x0002010c);
  GC0802_change_pll_settings(
      GC0802_CCM_ADDR, GC0802_BPLL_REG_OFFSET, 0x00020118);

  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_AXI_DIV_REG_OFFSET, 0x00000000);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_AXI_DIV_REG_OFFSET, 0xf0000000);

  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000002);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000004);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000008);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000010);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000011);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000012);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x00000002);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_APB_DIV_REG_OFFSET, 0x80000002);

  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000007);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000000);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000002);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000004);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000008);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000010);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000011);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000012);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0x00000007);
  WRITE_BURST_32(GC0802_CCM_ADDR, GC0802_RF_CFG_DIV_REG_OFFSET, 0xc0000007);

  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_AXI_DEV_RST_OFFSET, 0x80000007);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_APB_DEV_RST_OFFSET, 0x800002ff);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_RF_DFE_DEV_RST_OFFSET, 0x80000001);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_DEBUG_OFFSET, 0x00000000);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_DEBUG_OFFSET, 0x00000301);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_DEBUG_OFFSET, 0x00010301);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_DEBUG_OFFSET, 0x00180301);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_DEBUG_OFFSET, 0x00000100);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, GC0802_CLUSTER0_DEV_RST_OFFSET, 0xdfff1fff);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, AD9361_RST_CTRL_OFFSET, 0x00000003);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR, AD9361_DAC_IO_MODE_SWITCH_OFFSET, 0x00000400);

  GC0802_ioconfig();

  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR,
      GC0802_CLUSTER0_DEV_RST_OFFSET,
      READ_BURST_32(
          GC0802_DEVCTRL_ADDR, GC0802_CLUSTER0_DEV_RST_OFFSET) | 0x2000);
  WRITE_BURST_32(
      GC0802_DEVCTRL_ADDR,
      GC0802_RF_DFE_DEV_RST_OFFSET,
      READ_BURST_32(
          GC0802_DEVCTRL_ADDR, GC0802_RF_DFE_DEV_RST_OFFSET) | 0x2);

  for (volatile int wait = 0; wait < 1000; ++wait) {
  }
