    ' [Out] = Task_ltePDCCHChanneldecode(Out0x_0, Out0x_1, Out0x_2, Out1x_0, Out1x_1, Out1x_2, index00_8bit, index01_8bit, P0, P1, P2, demod_length)
    [Out] = Task_ltePDCCHChanneldecode(Out0x_0, Out0x_1, Out0x_2, Out1x_0, Out1x_1, Out1x_2, index00_8bit, index01_8bit, d0, d1, d2, range64_8bit, NDLRB, frame_type,DCIBits_length)
    [Crcout, crc_result] = Task_ltePDCCHCRC(Out, crcGen, crcmask, DCIBits_length)
    ' [dci] = Task_lteDCIDecode(dci_in, NDLRB, frame_type)
    [dci] = Task_lteDCIDecode(Crcout, NDLRB, frame_type)
    'endfor Candidate

    'endfor num_mi
}

